{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --env-file=.env .claude/hooks/check-luca-notes.mjs 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking Luca coordination notes..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/record-stop-turn.mjs",
            "timeout": 25,
            "statusMessage": "Recording turn..."
          }
        ]
      }
    ]
  }
}
