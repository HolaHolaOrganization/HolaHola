+        indexed = (await restarted.read('fixture'))!.content;
+      }), { indexed: 1, pending: 0 });
+      assert.equal(indexed, exact + '\nnewest exact message  \n');
+      assert.deepEqual(await restarted.pending(), []);
+      assert.equal((await pool.query('SELECT content FROM conversation_memories')).rows[0].content, indexed);
+      assert.deepEqual(await drainMemoryIndexRefreshes(restarted, async () => {
+        assert.fail('a completed request must not be rebuilt');
+      }), { indexed: 0, pending: 0 });
