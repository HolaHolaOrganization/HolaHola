new file mode 100644
index 0000000000000000000000000000000000000000..61dc588adddf482c58a170d5dededf4f44238b3e
--- /dev/null
+++ b/server/services/memory-index-refresh.ts
@@ -0,0 +1,125 @@
+/**
+ * Durable refresh obligations, consumed by the existing embedding indexer.
+ * One marker per source row coalesces arbitrarily many appends. It is NOT an
+ * embedding receipt: only a successful, version-matched rebuild clears it.
+ */
+import { sql } from 'drizzle-orm';
+
+export const MEMORY_INDEX_PENDING = 'memory-index:pending';
+
+/** Serialize derived writes across hosts without locking canonical source rows. */
+export async function withMemoryIndexLock<T>(id: string, build: () => Promise<T>): Promise<T> {
+  const { getSharedDb } = await import('../db');
+  // Transaction-scoped locks work with transaction-pooling endpoints. No
+  // source-row lock is held, so a remote embedding cannot block capture.
+  return getSharedDb().transaction(async tx => {
+    const lock = await tx.execute(sql`
+      SELECT pg_try_advisory_xact_lock(1162691140, hashtext(${id})) AS acquired
+    `);
+    if (!(lock as any).rows?.[0]?.acquired) {
+      throw new Error(`Index refresh already in progress for ${id}`);
+    }
+    return build();
+  });
+}
+
+export interface IndexSnapshot {
+  id: string;
+  title: string;
+  summary: string | null;
+  content: string;
+}
+
+export interface RefreshRepository {
+  pending(): Promise<string[]>;
+  read(id: string): Promise<IndexSnapshot | undefined>;
+  complete(snapshot: IndexSnapshot): Promise<boolean>;
+}
+
+/** Injection is per invocation, never a global switch that disables indexing. */
+export async function drainMemoryIndexRefreshes(
+  repository: RefreshRepository,
+  rebuild: (id: string) => Promise<void>,
+): Promise<{ indexed: number; pending: number }> {
+  let indexed = 0;
+  let pending = 0;
+  for (const id of await repository.pending()) {
+    try {
+      // Load one current source at a time, not every large episode into RAM.
+      const snapshot = await repository.read(id);
+      if (!snapshot) continue;
+      await rebuild(snapshot.id);
+      if (await repository.complete(snapshot)) indexed++;
+      else pending++; // A newer canonical version still needs a build.
+    } catch (error) {
+      pending++;
+      console.warn(`[EmbedIndexer] Refresh pending for ${id}:`, error);
+    }
+  }
+  return { indexed, pending };
+}
+
+export async function persistMemoryIndexRefresh(
+  db: { execute: (query: any) => Promise<any> }, id: string,
+): Promise<void> {
+  const result = await db.execute(sql`
+    UPDATE conversation_memories
+    SET tags = CASE WHEN ${MEMORY_INDEX_PENDING} = ANY(COALESCE(tags, ARRAY[]::text[]))
+      THEN tags ELSE array_append(COALESCE(tags, ARRAY[]::text[]), ${MEMORY_INDEX_PENDING}) END
+    WHERE id = ${id}
+    RETURNING id
+  `);
+  if (((result as any).rows ?? result).length !== 1) {
+    throw new Error(`Cannot persist index obligation: memory ${id} not found`);
+  }
+}
+
+export async function requestMemoryIndexRefresh(id: string): Promise<void> {
+  const { getMonitoringDb } = await import('../db');
+  await persistMemoryIndexRefresh(getMonitoringDb(), id);
+}
+
+export function sqlRefreshRepository(db: { execute: (query: any) => Promise<any> }): RefreshRepository {
+  return {
+    async pending() {
+      const result = await db.execute(sql`
+        SELECT id FROM conversation_memories
+        WHERE ${MEMORY_INDEX_PENDING} = ANY(tags)
+        ORDER BY created_at, id
+      `);
+      return (result.rows ?? result).map((row: { id: string }) => row.id);
+    },
+    async read(id) {
+      const result = await db.execute(sql`
+        SELECT id, title, summary, content FROM conversation_memories
+        WHERE id = ${id} AND ${MEMORY_INDEX_PENDING} = ANY(tags)
+      `);
+      return (result.rows ?? result)[0] as IndexSnapshot | undefined;
+    },
+    async complete(snapshot) {
+      const result = await db.execute(sql`
+        UPDATE conversation_memories
+        SET tags = array_remove(tags, ${MEMORY_INDEX_PENDING})
+        WHERE id = ${snapshot.id} AND content = ${snapshot.content}
+          AND title IS NOT DISTINCT FROM ${snapshot.title}
+          AND summary IS NOT DISTINCT FROM ${snapshot.summary}
+          AND ${MEMORY_INDEX_PENDING} = ANY(tags)
+        RETURNING id
+      `);
+      return (result.rows ?? result).length === 1;
+    },
+  };
+}
+
+let running: Promise<unknown> | undefined;
+
+/** Shared by server and watchdog; database advisory locks arbitrate hosts. */
+export function runPendingMemoryIndexRefreshes(): Promise<unknown> {
+  if (running) return running;
+  running = (async () => {
+    const { getMonitoringDb } = await import('../db');
+    const { reembedConversationMemory } = await import('../scripts/reembed-memory');
+    return drainMemoryIndexRefreshes(sqlRefreshRepository(getMonitoringDb()), reembedConversationMemory);
+  })().finally(() => { running = undefined; });
+  return running;
+}
