+
+const target = getVerifiedCiDatabaseUrl();
+test('durable coalescing, crash retry, version CAS and exact source preservation (PostgreSQL)',
+  { skip: !target && 'requires verified job-local CI_DATABASE_URL' }, async () => {
+    const namespace = `index_refresh_${randomUUID().replaceAll('-', '')}`;
+    const admin = new Pool({ connectionString: target });
+    const pool = new Pool({ connectionString: target, options: `-c search_path=${namespace}` });
+    try {
+      await admin.query(`CREATE SCHEMA ${namespace}`);
+      // Minimal synthetic schema, never a real episode or shared table.
+      await pool.query(`CREATE TABLE conversation_memories (
+        id text PRIMARY KEY, title text, summary text, content text NOT NULL,
+        tags text[], created_at timestamptz DEFAULT now()
+      )`);
+      const exact = 'David: exact source\t  \nLuca: accented café\n';
+      await pool.query('INSERT INTO conversation_memories VALUES ($1,$2,$3,$4,$5)',
+        ['fixture', 'Fixture', 'Summary', exact, ['source:synth', 'capture-id:synthetic']]);
+      const db = drizzle(pool);
+      const repository = sqlRefreshRepository(db);
+      await Promise.all(Array.from({ length: 33 }, () => persistMemoryIndexRefresh(db, 'fixture')));
+      assert.deepEqual(await repository.pending(), ['fixture']);
+      const tags = (await pool.query('SELECT tags FROM conversation_memories')).rows[0].tags;
+      assert.equal(tags.filter((tag: string) => tag === MEMORY_INDEX_PENDING).length, 1);
+      assert.ok(tags.includes('capture-id:synthetic'));
+      await assert.rejects(persistMemoryIndexRefresh(db, 'missing'), /not found/);
+
+      const snapshot = (await repository.read('fixture'))!;
+      // A partial remote build followed by a crash/failure cannot clear pending.
+      assert.deepEqual(await drainMemoryIndexRefreshes(repository, async () => {
+        throw new Error('remote failure after partial build');
+      }), { indexed: 0, pending: 1 });
+      assert.equal((await repository.read('fixture'))!.content, exact);
+
+      let release!: () => void;
+      let started!: () => void;
+      const entered = new Promise<void>(r => { started = r; });
+      const wait = new Promise<void>(r => { release = r; });
+      const slow = drainMemoryIndexRefreshes(repository, async () => { started(); await wait; });
+      await entered;
+      await pool.query('UPDATE conversation_memories SET content = content || $1 WHERE id=$2',
+        ['\nnewest exact message  \n', 'fixture']);
+      await persistMemoryIndexRefresh(db, 'fixture');
+      release();
+      assert.deepEqual(await slow, { indexed: 0, pending: 1 });
+      assert.equal(await repository.complete(snapshot), false);
+      // New repository instance models a restarted process, with no RAM queue.
+      const restarted = sqlRefreshRepository(drizzle(pool));
+      let indexed = '';
