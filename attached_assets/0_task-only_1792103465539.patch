+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFileSync } from 'node:fs';
+import { drainMemoryIndexRefreshes, MEMORY_INDEX_PENDING, type IndexSnapshot, type RefreshRepository } from './memory-index-refresh';
+
+function fixture() {
+  let current: IndexSnapshot = { id: 'synthetic', title: 'Fixture', summary: 'Synthetic summary', content: 'exact source\n whitespace  \n' };
+  let pending = true;
+  const repository: RefreshRepository = {
+    async pending() { return pending ? [current.id] : []; },
+    async read() { return pending ? { ...current } : undefined; },
+    async complete(snapshot) {
+      if (JSON.stringify(snapshot) !== JSON.stringify(current)) return false;
+      pending = false;
+      return true;
+    },
+  };
+  return {
+    repository,
+    current: () => ({ ...current }),
+    pending: () => pending,
+    append: (text: string) => { current.content += text; pending = true; },
+  };
+}
+
+test('failed indexing leaves an explicit obligation; retries are idempotent and source-exact', async () => {
+  const f = fixture();
+  const original = f.current();
+  const first = await drainMemoryIndexRefreshes(f.repository, async () => { throw new Error('remote embedding unavailable'); });
+  assert.deepEqual(first, { indexed: 0, pending: 1 });
+  assert.equal(f.pending(), true);
+  assert.deepEqual(f.current(), original);
+  let builds = 0;
+  const rebuild = async () => { builds++; };
+  assert.deepEqual(await drainMemoryIndexRefreshes(f.repository, rebuild), { indexed: 1, pending: 0 });
+  assert.deepEqual(await drainMemoryIndexRefreshes(f.repository, rebuild), { indexed: 0, pending: 0 });
+  assert.equal(builds, 1);
+  assert.deepEqual(f.current(), original);
+});
+
+test('slow old build does not block saving; only the newest version can clear pending', async () => {
+  const f = fixture();
+  let release!: () => void;
+  let started!: () => void;
+  const entered = new Promise<void>(resolve => { started = resolve; });
+  const held = new Promise<void>(resolve => { release = resolve; });
+  const old = f.current().content;
+  const build = drainMemoryIndexRefreshes(f.repository, async () => { started(); await held; });
+  await entered;
+  // These are committed source appends, not work waiting behind an embedding.
+  for (let i = 0; i < 33; i++) f.append(`\nmessage ${i}: exact\ttext  `);
+  assert.equal(f.pending(), true);
+  release();
+  assert.deepEqual(await build, { indexed: 0, pending: 1 });
+  assert.equal(f.current().content.startsWith(old), true);
+  let indexedContent = '';
+  await drainMemoryIndexRefreshes(f.repository, async () => { indexedContent = f.current().content; });
+  assert.equal(indexedContent, f.current().content);
+  assert.equal(f.pending(), false);
+  assert.equal((indexedContent.match(/message \d+:/g) ?? []).length, 33);
+});
+
+test('one failed memory does not prevent another pending memory from indexing', async () => {
+  const completed: string[] = [];
+  const repository: RefreshRepository = {
+    async pending() { return ['bad', 'good']; },
+    async read(id) { return { id, title: id, summary: '', content: id }; },
+    async complete(snapshot) { completed.push(snapshot.id); return true; },
+  };
+  assert.deepEqual(await drainMemoryIndexRefreshes(repository, async id => {
+    if (id === 'bad') throw new Error('failure');
+  }), { indexed: 1, pending: 1 });
+  assert.deepEqual(completed, ['good']);
+});
+
+test('production paths keep the durable obligation and real indexing enabled', () => {
+  const watchdog = readFileSync('server/scripts/capture-watchdog.ts', 'utf8');
+  const autosave = readFileSync('server/services/agent-session-autosave.ts', 'utf8');
+  const indexer = readFileSync('server/services/memory-embedding-indexer.ts', 'utf8');
+  const builder = readFileSync('server/scripts/reembed-memory.ts', 'utf8');
+  assert.match(watchdog, /void runPendingMemoryIndexRefreshes\(\)/);
+  assert.match(indexer, /await runPendingMemoryIndexRefreshes\(\)/);
+  assert.match(autosave, /await requestMemoryIndexRefresh\(memoryId as string\)/);
+  assert.match(builder, /withMemoryIndexLock/);
+  assert.match(readFileSync('server/services/memory-index-refresh.ts', 'utf8'), /pg_try_advisory_xact_lock/);
+  assert.equal((builder.match(/importance, db, true\)/g) ?? []).length, 3);
+  assert.equal(MEMORY_INDEX_PENDING, 'memory-index:pending');
+});
