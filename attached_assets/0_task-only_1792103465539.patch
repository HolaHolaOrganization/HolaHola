+test('real builder retries partial failures, serializes hosts, indexes latest version and refuses false success',
+  { skip: !target && 'requires verified job-local CI_DATABASE_URL' }, async t => {
+    const database = `index_rebuild_${randomUUID().replaceAll('-', '')}`;
+    const admin = new Pool({ connectionString: target });
+    const url = new URL(target!);
+    url.pathname = `/${database}`;
+    let pool: Pool | undefined;
+    let closeDb: (() => Promise<void>) | undefined;
+    try {
+      await admin.query(`CREATE DATABASE ${database}`);
+      // Only this test process changes target. No production environment/config
+      // and no application-wide "disable indexing" hook is involved.
+      process.env.CI_DATABASE_URL = url.href;
+      process.env.NEON_SHARED_DATABASE_URL = url.href;
+      process.env.USER_OPENAI_API_KEY = 'synthetic-test-input';
+      pool = new Pool({ connectionString: url.href });
+      await pool.query(`
+        CREATE TABLE conversation_memories (
+          id text PRIMARY KEY, title text NOT NULL, summary text NOT NULL,
+          content text NOT NULL, importance integer DEFAULT 7, tags text[],
+          created_at timestamptz DEFAULT now()
+        );
+        CREATE TABLE memory_embeddings (
+          id text PRIMARY KEY DEFAULT gen_random_uuid()::text,
+          memory_type text NOT NULL, memory_id text NOT NULL, user_id text,
+          embedding jsonb NOT NULL, content_hash text NOT NULL,
+          created_at timestamptz DEFAULT now(), strength real DEFAULT 1,
+          importance integer DEFAULT 5, last_reinforced_at timestamptz DEFAULT now(),
+          pinned boolean DEFAULT false, UNIQUE(memory_type, memory_id)
+        );
+      `);
+      const source = 'David: exact café\t  \nLuca: exact reply.\n'.repeat(320);
+      await pool.query('INSERT INTO conversation_memories (id,title,summary,content,tags) VALUES ($1,$2,$3,$4,$5)',
+        ['synthetic', 'Synthetic record', 'A synthetic summary for indexing', source, ['capture-id:synthetic']]);
+      const db = drizzle(pool);
+      const repository = sqlRefreshRepository(db);
+      await persistMemoryIndexRefresh(db, 'synthetic');
+      const { reembedConversationMemory } = await import('../scripts/reembed-memory');
+      const { splitIntoChunks, reformatSpeakerHeaders } = await import('./memory-embedding-indexer');
+      const { hashContent } = await import('./semantic-memory-service');
+      closeDb = (await import('../db')).closeDbConnections;
+      let requests = 0;
+      let failChunk = true;
+      let hold = false;
+      let entered!: () => void;
+      let release!: () => void;
+      t.mock.method(globalThis, 'fetch', async (input: any, init: any) => {
+        assert.equal(String(input), 'https://api.openai.com/v1/embeddings');
+        requests++;
+        const text = JSON.parse(init.body).input;
+        if (hold) {
+          hold = false;
+          entered();
+          await new Promise<void>(resolve => { release = resolve; });
+        }
+        if (failChunk && text.startsWith('[Memory:')) {
+          return new Response('synthetic remote chunk failure', { status: 503 });
+        }
+        return Response.json({ data: [{ embedding: [1, 0, 0] }] });
+      });
+
+      assert.deepEqual(await drainMemoryIndexRefreshes(repository, reembedConversationMemory),
+        { indexed: 0, pending: 1 });
+      assert.deepEqual(await repository.pending(), ['synthetic']);
+      assert.equal((await repository.read('synthetic'))!.content, source);
+      assert.ok((await pool.query('SELECT * FROM memory_embeddings')).rows.length >= 2);
+
+      failChunk = false;
+      // Hold an actual embedding request while another host attempts this ID
+      // and while capture commits a newer source without acquiring that lock.
+      await pool.query('DELETE FROM memory_embeddings');
+      hold = true;
+      const started = new Promise<void>(resolve => { entered = resolve; });
+      const building = drainMemoryIndexRefreshes(repository, reembedConversationMemory);
+      await started;
+      await assert.rejects(reembedConversationMemory('synthetic'), /already in progress/);
+      const latest = source + '\nDavid: newest exact message  \n';
+      await pool.query('UPDATE conversation_memories SET content=$1 WHERE id=$2', [latest, 'synthetic']);
+      await persistMemoryIndexRefresh(db, 'synthetic');
+      release();
+      assert.deepEqual(await building, { indexed: 0, pending: 1 });
+      assert.deepEqual(await drainMemoryIndexRefreshes(repository, reembedConversationMemory),
+        { indexed: 1, pending: 0 });
+      assert.deepEqual(await repository.pending(), []);
+      const rows = (await pool.query('SELECT memory_type,memory_id,content_hash FROM memory_embeddings')).rows;
+      const chunks = splitIntoChunks(latest);
+      const expected = [
+        ['conversation_memory', 'synthetic', hashContent(['Synthetic record', 'A synthetic summary for indexing', latest].join('\n\n'))],
+        ['conversation_summary', 'synthetic', hashContent('Synthetic record\n\nA synthetic summary for indexing')],
+        ...chunks.map((chunk, i) => ['conversation_chunk', `synthetic:chunk:${i}`,
+          hashContent(`[Memory: Synthetic record | Part ${i + 1} of ${chunks.length}]\n\n${reformatSpeakerHeaders(chunk)}`)]),
+      ];
+      assert.equal(rows.length, expected.length);
+      for (const [type, id, hash] of expected) {
+        assert.equal(rows.find(row => row.memory_type === type && row.memory_id === id)?.content_hash, hash);
+      }
+      const before = requests;
+      await reembedConversationMemory('synthetic');
+      assert.equal(requests, before, 'an idempotent retry makes no remote requests');
+      assert.equal((await pool.query('SELECT content FROM conversation_memories')).rows[0].content, latest);
+
+      // A missing endpoint/key must not be mistaken for an unchanged hash.
+      delete process.env.USER_OPENAI_API_KEY;
+      await pool.query("UPDATE conversation_memories SET title='Changed title'");
+      await persistMemoryIndexRefresh(db, 'synthetic');
+      assert.deepEqual(await drainMemoryIndexRefreshes(repository, reembedConversationMemory),
+        { indexed: 0, pending: 1 });
+      assert.deepEqual(await repository.pending(), ['synthetic']);
+    } finally {
+      if (closeDb) await closeDb();
+      await pool?.end();
+      await admin.query(`DROP DATABASE IF EXISTS ${database}`);
+      await admin.end();
+    }
+  });
