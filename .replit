onBoot = "/bin/sh server/scripts/coordination-listener-boot-diagnostic.sh"
modules = ["nodejs-20", "web", "python-3.11", "python3", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["git", "openssh", "chromium", "imagemagick", "gitleaks", "glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "libdrm", "mesa", "pango", "cairo", "gtk3", "fontconfig", "freetype", "gdk-pixbuf", "harfbuzz", "alsa-lib", "libxkbcommon", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "powershell"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5010
externalPort = 3000

[[ports]]
localPort = 5011
externalPort = 4200

[[ports]]
localPort = 5012
externalPort = 3001

[[ports]]
localPort = 5099
externalPort = 3003

[[ports]]
localPort = 5904
externalPort = 3002

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"


[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Validation suite"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Consolidated CI"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/launch-gate.sh capture-watchdog -- npx tsx server/scripts/capture-watchdog.ts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "luca-chat-canonical-save"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "user-openai-key-absent"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-application.sh"


[[workflows.workflow]]
name = "Validation suite"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/launch-gate.sh validation-suite -- bash server/scripts/run-validation-suite.sh"

[workflows.workflow.metadata]
isValidation = true
outputType = "console"

[[workflows.workflow]]
name = "Consolidated CI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/launch-gate.sh consolidated-ci -- bash server/scripts/test-all-consolidated-ci.sh"

[workflows.workflow.metadata]
isValidation = true
outputType = "console"

[[workflows.workflow]]
name = "luca-chat-canonical-save"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/launch-gate.sh luca-chat-canonical-save -- npx tsx server/scripts/test-luca-chat-canonical-save.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "user-openai-key-absent"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash server/scripts/check-user-openai-key-absent.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_openai_ai_integrations:1.0.0", "javascript_mem_db:1.0.0", "javascript_log_in_with_replit:1.0.0", "stripe:1.0.0", "javascript_gemini_ai_integrations:1.0.0", "javascript_anthropic_ai_integrations:1.0.0", "perplexity_v0:1.0.0", "javascript_object_storage:2.0.0"]

[userenv]

[userenv.shared]
TTS_PRIMARY_PROVIDER = "google"
CARTESIA_PRONUNCIATION_DICT_IDS = "{\"spanish\":\"pdict_6PLDfmxcwFMXcNzupDAtGN\",\"french\":\"pdict_bH9XV8ysTebsn7NGkQTRVR\",\"german\":\"pdict_x7RvPGuw4MDAgrXmFbuscG\",\"italian\":\"pdict_hzt7xBGNNwTJmPw8T7mVj2\",\"portuguese\":\"pdict_rBkocHMkYSYbFVcnopCqam\",\"japanese\":\"pdict_dZE2eKzRRt71JDoL6XYMvm\",\"mandarin chinese\":\"pdict_VH25Wo8GMJ2GMtEDU8CdWY\",\"korean\":\"pdict_5fsZLioheLeUoJ17TXzSob\"}"
APP_NAME = "HolaHola"
APP_URL = "https://getholahola.com"
FROM_EMAIL = "noreply@getholahola.com"
COMPASS_ENABLED = "true"
DEEPGRAM_MODEL = "nova-3"
DEEPGRAM_INTELLIGENCE_ENABLED = "true"
GEMINI_LIVE_VOICE = "true"
AWS_S3_REGION = "auto"
DEFAULT_OBJECT_STORAGE_BUCKET_ID = "holaholar2bucket"
PRIVATE_OBJECT_DIR = "/holaholar2bucket/.private"
PUBLIC_OBJECT_SEARCH_PATHS = "/holaholar2bucket/public"
SOURCE_PROMOTION_API_ENABLED = "true"
SOURCE_RELEASE_HEALTH_URL = "https://getholahola.com/health/release"
GITHUB_REPO_URL = "https://github.com/davidwmcintosh/holahola.git"

[userenv.development]
SYNC_PEER_URL = "https://getholahola.com"
NEON_STRICT_MODE = "true"
COORDINATION_PUBLIC_ENDPOINT = "https://3ca2376d-c3dc-490a-a375-6b2f97f7c281-00-i0c3jqj8bdra.janeway.replit.dev"

[userenv.production]
SYNC_PEER_URL = "https://3ca2376d-c3dc-490a-a375-6b2f97f7c281-00-i0c3jqj8bdra.janeway.replit.dev"
NEON_STRICT_MODE = "true"
COORDINATION_PUBLIC_ENDPOINT = "https://getholahola.com"

[objectStorage]
defaultBucketID = "replit-objstore-cf6ba6d4-2685-4f0a-9ea8-f1861aefef11"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 480000
