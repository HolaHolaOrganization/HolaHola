# Copy this to .env and fill in values from Replit Secrets panel
# Run: cp .env.template .env

# ── Instance role (REQUIRED — the server refuses to boot without it) ──────────
# `dev` starts NO background workers, schedulers, capture or boot writes against
# the shared database; `production` is for the Render production service only.
# See server/services/instance-role.ts.
HOLAHOLA_INSTANCE_ROLE=dev

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Both point to the same Neon connection string — copy from Neon dashboard
# or from Replit Secrets panel under NEON_SHARED_DATABASE_URL
NEON_SHARED_DATABASE_URL=
DATABASE_URL=

# Need an isolated database instead of the shared one above (exploratory
# testing, a Codespace/sandbox environment, anything that shouldn't touch
# shared production data)? Don't add a static variable here — run
# `npm run db:branch -- create <name>` and point NEON_SHARED_DATABASE_URL at
# the branch it prints, for that environment only. See
# .agents/skills/neon-branch/SKILL.md. (A static NEON_TEST_DATABASE_URL used
# to live here; retired 2026-08-30 — see
# docs/superpowers/specs/2026-08-26-claude-code-test-environment-design.md's
# Amendment for why.)

# Neon Management API — used only by scripts/neon-branch.ts to create/list/
# delete branches (see docs/superpowers/specs/2026-08-30-neon-branch-migration-workflow-design.md).
# NEON_API_KEY can create and delete branches; it cannot read table data and
# is never itself a Postgres connection string. Get it from the Neon console
# under Account Settings > API Keys, scoped to the minimum role available.
# NEON_PROJECT_ID is the project slug shown in the Neon console URL/Settings —
# not a secret, but still project-specific.
NEON_API_KEY=
NEON_PROJECT_ID=

# Note: PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE are auto-injected
# by Replit's infrastructure — they do NOT appear in the Secrets panel and
# you do NOT need to set them locally. Use the two variables above instead.

# ── Cross-tool promotion (external callers, not Replit's own dev checkout) ────
# One shared way for any tool that isn't Replit's own dev checkout (Claude
# Code, Cursor, Antigravity, a human) to get a committed branch onto main
# safely — see .agents/skills/cross-tool-promote/SKILL.md and
# docs/superpowers/specs/2026-08-26-unified-source-promote-endpoint-design.md.
# Replit's own dev checkout has a separate, differently-scoped entry point
# (server/services/source-control-service.ts) — not a duplicate, see that
# design doc's "Two entry points" note.
# scripts/cross-tool-promote.ts calls the GitHub Actions API directly (no
# HolaHola server involved — nothing to host, nothing to keep up). Needed by
# anyone running that script: a GitHub fine-grained personal access token,
# scoped to this repo only, with "Actions: Read and write" permission and
# nothing else. Triggers/polls the .github/workflows/cross-tool-promote.yml run
# that does the actual validation and push — never used to push code
# directly, never holds repo-write access.
GITHUB_ACTIONS_DISPATCH_TOKEN=

# REPLIT_AGENT_TOKEN authenticates internal agent-to-server endpoints
# (x-agent-token header) — including record-exchange.ts's --remote mode,
# which POSTs to a live server's /api/internal/canonical-conversation-exchange
# instead of writing a local .chat_capture file that nothing would drain on a
# machine with no autosave worker running. Same value the server itself
# checks requests against; never generated by a caller.
REPLIT_AGENT_TOKEN=

# Coordination runtimes should normally receive only their own bootstrap
# credential from a dedicated 1Password service account/vault item. The broker
# exchanges it for an in-memory, short-lived token. Never commit or share these
# values between runtimes. See docs/coordination-clients.md.
COORDINATION_API_URL=
COORDINATION_ACTOR=
COORDINATION_RUNTIME_ID=
COORDINATION_RUNTIME_BOOTSTRAP_TOKEN=

# Server-only key (32+ characters) for HMAC-pseudonymizing source IP addresses
# in coordination credential audit events. If absent, no IP-derived value is
# stored. Do not expose this to coordination clients.
COORDINATION_AUDIT_HMAC_KEY=

# Optional override for record-exchange.ts --remote's target server. Defaults
# to https://getholahola.com (production — the one place guaranteed to be
# running the autosave worker that actually drains captured exchanges).
# HOLAHOLA_REMOTE_URL=

# ── AI providers ─────────────────────────────────────────────────────────────
# Single OpenAI key used everywhere (embeddings, TTS fallback, Realtime API,
# pronunciation analysis). On Replit, AI_INTEGRATIONS_OPENAI_API_KEY is the
# proxy key (set automatically); outside Replit only OPENAI_API_KEY is needed.
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# ── Voice (Deepgram live STT) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Object storage (S3-compatible) ───────────────────────────────────────────
AWS_S3_ENDPOINT=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Primary application/read-path bucket. The legacy name remains active for R2.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# Archive/migration destination; may intentionally match the primary bucket.
AWS_S3_DESTINATION_BUCKET=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Reconciliation replica ────────────────────────────────────────────────────
RECONCILIATION_REPLICA_ENDPOINT=
RECONCILIATION_REPLICA_BUCKET=
RECONCILIATION_REPLICA_REGION=
RECONCILIATION_REPLICA_ACCESS_KEY_ID=
RECONCILIATION_REPLICA_SECRET_ACCESS_KEY=

# ── Session / auth ────────────────────────────────────────────────────────────
SESSION_SECRET=
SYNC_SHARED_SECRET=

# ── Source promotion API (disabled by default) ────────────────────────────────
# Set the flag only after storing a dedicated SOURCE_PROMOTION_TOKEN in Replit
# Secrets. This API prepares and records an explicit Replit Publish; it cannot
# publish programmatically.
SOURCE_PROMOTION_API_ENABLED=false
SOURCE_PROMOTION_TOKEN=

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Misc ──────────────────────────────────────────────────────────────────────
RAW_WINDOW_RECEIPT_PRIVATE_KEY=
RAW_WINDOW_RECEIPT_PRIVATE_KEY_B64=

# ── Dev/test agent login ──────────────────────────────────────────────────────
# Password for the shared seeded account (scripts/data-ops/seed-dev-test-account.ts)
# that agents/CI log into via POST /api/auth/password/login instead of a bypass.
# The account is founder-equivalent for requireFounder-gated routes, but ONLY
# outside NODE_ENV=production (see server/middleware/rbac.ts's isFounderId()).
DEV_TEST_ACCOUNT_PASSWORD=
