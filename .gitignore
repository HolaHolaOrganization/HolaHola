node_modules
dist
.DS_Store

# Coordinator V2 host-installed runtime generations and retry staging
/runtime/
/.coordination-v2-runtime-manifest.json
/.coordination-v2-execution-journal/
/.coordination-v2-interactive-session/
/.runtime-bootstrap-staging-*/
/.runtime-bootstrap-old-*

# Local environment secrets
.env
.env.*
!.env.example
!.env.template
*.pem
# Public half of the Coordinator V2 runtime-release signing keypair. Not a
# secret (the private half is COORDINATION_V2_SERVER_SIGNING_PRIVATE_KEY,
# held outside git) -- this file must be tracked so protected GitHub
# snapshots can hash-pin it as a RUNTIME_SOURCE_MEMBER_PATHS entry.
!scripts/coordination-v2-server-signing-public.pem
*.key
server/public
vite.config.ts.*
*.tar.gz
.claude/settings.local.json

# Replit internal files
.local/
.cache/replit/
*.db
.replit.nix

# Claude Code personal/machine-specific overrides
.claude/settings.local.json

# Auto-generated runtime docs — regenerated on every server start
docs/agent-briefing.md
docs/alden-to-agent.md
docs/founder-to-agent.md
docs/shared-lobe-snapshot.md
nohup.out

# CI/test episode fixtures — written to disk by test setup, unlinked by test
# teardown (e.g. test-chat-episode-hook-e2e.ts's docs/episode-9993.md). Never
# meant to be tracked; ignoring them stops a mid-test-run commit from sweeping
# one in. Reserved range matches RESERVED_FIXTURE_EPISODE_MIN in
# server/services/episode-content-loss-guard.ts — keep both in sync.
docs/episode-99[0-9][0-9].md
docs/episode-9[0-9][0-9][0-9][0-9].md
# Legacy bare-numbered fixture predating the range above — test-rolling-sync-
# guard.ts's real-repo fixture. Matches LEGACY_RESERVED_FIXTURE_EPISODE_NUMBERS
# in the same guard module — keep both in sync.
docs/episode-99.md

# Approved private Windows signing-pilot transfers are not source releases.
attached_assets/runtime-onboarding-windows-signed-pilot*.zip
/generated-artifacts/
